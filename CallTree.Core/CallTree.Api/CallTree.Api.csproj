<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6d205c5f-1b8f-430e-8396-d520145654cf</UserSecretsId>
    <ApplicationIcon>CallTree.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CallTree.Infrastructure\CallTree.Infrastructure.csproj" />
    <ProjectReference Include="..\CallTree.Messaging\CallTree.Messaging.csproj" />
    <ProjectReference Include="..\CallTree.Telephony\CallTree.Telephony.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PromptLibrary resolves these against the content root, which is the output directory once published. -->
    <Content Include="prompts\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="CallTree.ico" />
  </ItemGroup>

  <!--
    wwwroot holds the built SvelteKit UI, which only the container build produces (deploy/Dockerfile
    copies it in), so it is gitignored and absent from a fresh clone. The build still writes a static
    web assets manifest naming it, and in Development the host reads that manifest while constructing
    the builder - a missing directory is an unhandled DirectoryNotFoundException before a single line
    of Program.Main runs. Creating it here is the only fix that lands early enough.
  -->
  <Target Name="EnsureWebRoot" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" />
  </Target>

</Project>
