{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CallTree": "Data Source=data/calltree.db"
  },
  "Storage": {
    "RecordingsRoot": "data/recordings",
    "ConfigFile": "data/config.json"
  },
  "Telephony": {
    "MyCellNumber": "",
    "SipListenPort": 5060,
    "RtpPortStart": 10000,
    "RtpPortEnd": 10100,
    "TraceSip": false
  },
  "Trunk": {
    "Host": "",
    "Port": 5060,
    "Username": "",
    "Password": "",
    "RegistrationExpirySeconds": 120
  },
  "Messaging": {
    "Enabled": false,
    "PublicKey": "",
    "MessagingProfileId": "",
    "RequireSignature": true,
    "SignatureToleranceSeconds": 300,
    "NotifyOnFailure": true,
    "ApiTimeoutSeconds": 10
  }
}
